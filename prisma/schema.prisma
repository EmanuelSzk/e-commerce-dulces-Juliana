// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROCESS
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

// id matches Supabase auth.users.id (uuid). Created/kept in sync on
// signup via a Server Action, not FK-enforced (auth.users lives in Supabase's own schema).
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String
  role      UserRole @default(CUSTOMER)
  orders    Order[]
  createdAt DateTime @default(now())

  @@map("profiles")
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String
  imageUrl    String?
  active      Boolean          @default(true)
  category    Category         @relation(fields: [categoryId], references: [id])
  categoryId  String
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("products")
}

// Price and stock live here, not on Product: a cake sells as "8 porciones" /
// "12 porciones" at different prices. Products with a single presentation
// still get exactly one variant.
model ProductVariant {
  id         String      @id @default(cuid())
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  name       String
  price      Decimal     @db.Decimal(10, 2)
  stock      Int         @default(0)
  active     Boolean     @default(true)
  position   Int         @default(0)
  orderItems OrderItem[]

  @@unique([productId, name])
  @@map("product_variants")
}

// Single-row store configuration (id is always "store"), editable later from
// the admin panel. Delivery is Posadas-only at one flat rate, so no zones.
model StoreSettings {
  id               String   @id @default("store")
  shippingCost     Decimal  @db.Decimal(10, 2)
  freeShippingFrom Decimal  @db.Decimal(10, 2)
  pickupAddress    String
  updatedAt        DateTime @updatedAt

  @@map("store_settings")
}

model Order {
  id              String         @id @default(cuid())
  user            Profile        @relation(fields: [userId], references: [id])
  userId          String         @db.Uuid
  status          OrderStatus    @default(PENDING)
  items           OrderItem[]
  payment         Payment?
  deliveryMethod  DeliveryMethod
  contactName     String
  contactPhone    String
  // Null when the customer picks the order up at the store.
  shippingAddress String?
  subtotal        Decimal        @db.Decimal(10, 2)
  shippingCost    Decimal        @db.Decimal(10, 2)
  total           Decimal        @db.Decimal(10, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String         @id @default(cuid())
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  variantId String
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)

  @@map("order_items")
}

// Tracks the Mercado Pago preference/payment behind an order (Checkout Pro + webhooks).
model Payment {
  id             String        @id @default(cuid())
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String        @unique
  mpPreferenceId String?
  // Checkout Pro link, kept so an abandoned payment can be resumed later.
  mpInitPoint    String?
  mpPaymentId    String?       @unique
  status         PaymentStatus @default(PENDING)
  rawPayload     Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("payments")
}
